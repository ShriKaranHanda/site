#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  # Deleting main has no new commit to validate.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  echo "Checking favicons before pushing to main..."
  node scripts/sync-favicons.mjs --check-ref "$local_sha" || exit 1
done
